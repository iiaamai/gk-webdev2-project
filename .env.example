APP_NAME="GK Trucking Services"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Render (Blueprint): DB_CONNECTION=pgsql and DB_URL from linked Postgres (see render.yaml).
# DB_SSLMODE=require
# DB_URL=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Documents use Cloudinary whenever credentials are set (even if FILESYSTEM_DISK=local).
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Optional overrides if the URL is wrong: CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET
# CLOUDINARY_FOLDER=gk-trucking
# Media Library: filter Authenticated (uploads are not Public).
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Production (Brevo SMTP): MAIL_MAILER=smtp, MAIL_SCHEME=smtps, MAIL_HOST=smtp-relay.brevo.com, MAIL_PORT=465
# MAIL_USERNAME=, MAIL_PASSWORD= (Brevo SMTP key), GK_MAIL_ENABLED=true, verified MAIL_FROM_ADDRESS

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Placeholder integrations (see docs/development/env_checklist.txt)
# Mapbox: set MAPBOX_TOKEN (pk.* public token) and GK_MAPBOX_ENABLED=true (Render: add token in dashboard)
# MAPBOX_TOKEN=
# PAYMONGO_SECRET_KEY=
# PAYMONGO_PUBLIC_KEY=
# Set true to send verification and lifecycle emails (see env_checklist.txt)
GK_MAIL_ENABLED=false
GK_MAPBOX_ENABLED=false
GK_PAYMONGO_ENABLED=false
# GK_ACTIVITY_IP_LOOKUP=false
